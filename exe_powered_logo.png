<odeNavStructure>
  <odePageId>page-1776353268955-ka0t872vt</odePageId>
  <odeParentPageId></odeParentPageId>
  <pageName>Guía didáctica </pageName>
  <odeNavStructureOrder>7</odeNavStructureOrder>
  <odeNavStructureProperties>
    <odeNavStructureProperty>
      <key>titlePage</key>
      <value>Guía didáctica </value>
    </odeNavStructureProperty>
  </odeNavStructureProperties>
  <odePagStructures>
    <odePagStructure>
      <odePageId>page-1776353268955-ka0t872vt</odePageId>
      <odeBlockId>block-1776353797131-23ovl2pso</odeBlockId>
      <blockName>Texto</blockName>
      <iconName></iconName>
      <odePagStructureOrder>1</odePagStructureOrder>
      <odePagStructureProperties>
        <odePagStructureProperty>
          <key>visibility</key>
